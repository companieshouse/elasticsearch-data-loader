environment = "cidev"
aws_profile = "development-eu-west-2"

# service configs
use_set_environment_files = true

# default allocation
required_cpus = 16384
required_memory = 32768

# scaling configs default
desired_task_count = 0
min_task_count = 0
max_task_count = 1

# Scheduled scaling of tasks
service_autoscale_enabled  = false