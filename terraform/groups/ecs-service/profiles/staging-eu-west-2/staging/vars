environment = "staging"
aws_profile = "staging-eu-west-2"

# service configs
use_set_environment_files = true
log_level = "trace"

# default allocation (task total incl. alphakey sidecar: 16384 CPU, 32768 memory)
required_cpus = 15360
required_memory = 30720

# scaling configs default
desired_task_count = 0
min_task_count = 0
max_task_count = 1

# Scheduled scaling of tasks
service_autoscale_enabled  = false